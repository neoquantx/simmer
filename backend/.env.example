DB_BACKEND=sqlite
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/simmer
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=240
OLLAMA_KEEP_ALIVE=30m

# UPI yearly payment (shown as QR on the offer screen)
SIMMER_UPI_ID=yourname@oksbi
SIMMER_UPI_NAME=Simmer
SIMMER_UPI_NOTE=Simmer year
YEARLY_AMOUNT_INR=99

# Password for http://localhost:5173/admin
ADMIN_PASSWORD=change-me

# Browser origins allowed to call the API (comma separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Receipt email (sent automatically when you toggle Paid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SUPPORT_EMAIL=you@gmail.com
